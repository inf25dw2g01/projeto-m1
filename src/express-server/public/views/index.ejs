<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>API Auth Portal</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <div class="grid-overlay"></div>

  <main class="container">

    <!-- HEADER -->
    <header class="hero">
      <div class="hero-badge">REST API</div>
      <h1 class="hero-title">Auth<span class="accent">Portal</span></h1>
      <p class="hero-sub">Acesso seguro. Múltiplos métodos. Uma porta de entrada.</p>
    </header>

    <!-- ============================================================ -->
    <!-- ESTADO NÃO AUTENTICADO                                        -->
    <!-- ============================================================ -->
    <% if (!user) { %>

    <div class="auth-grid">

      <!-- BLOCO 1: BASIC AUTH -->
      <div class="auth-card" id="card-basic">
        <div class="card-label">
          <span class="label-dot dot-cyan"></span>
          Basic Auth
        </div>
        <h2 class="card-title">Credenciais</h2>
        <p class="card-desc">Autentica com o teu email e password via HTTP Basic Auth.</p>

        <form action="/auth/basic" method="POST" class="auth-form">

          <div class="field-group">
            <label for="email">Email</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <input type="email" id="email" name="email" placeholder="utilizador@exemplo.com" required autocomplete="email" />
            </div>
          </div>

          <div class="field-group">
            <label for="password">Password</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              <input type="password" id="password" name="password" placeholder="••••••••••" required autocomplete="current-password" />
            </div>
          </div>

          <button type="submit" class="btn btn-primary">
            <span>Entrar</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </button>

        </form>
      </div>

      <!-- DIVISOR VERTICAL -->
      <div class="divider-vertical">
        <span>ou</span>
      </div>

      <!-- BLOCO 2: API KEY -->
      <div class="auth-card" id="card-apikey">
        <div class="card-label">
          <span class="label-dot dot-amber"></span>
          API Key
        </div>
        <h2 class="card-title">Chave de Acesso</h2>
        <p class="card-desc">Autentica diretamente com o teu token via cabeçalho <code>x-api-key</code>.</p>

        <form action="/auth/apikey" method="POST" class="auth-form">

          <div class="field-group">
            <label for="apikey">x-api-key</label>
            <div class="input-wrapper">
              <svg class="input-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
              </svg>
              <input type="text" id="apikey" name="apikey" placeholder="sk-••••••••••••••••••••" required autocomplete="off" class="mono" />
            </div>
          </div>

          <button type="submit" class="btn btn-secondary">
            <span>Validar Chave</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </button>

        </form>
      </div>

    </div><!-- /auth-grid -->


    <% if (typeof apikey_status !== 'undefined' && apikey_status === 'valid') { %>
      <div class="apikey-result apikey-valid">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div>
          <p class="result-title">API Key válida</p>
          <p class="result-sub">Bem-vindo de volta, <strong><%= apikey_name %></strong> · <%= apikey_email %></p>
        </div>
      </div>
    <% } else if (typeof apikey_status !== 'undefined' && apikey_status === 'invalid') { %>
      <div class="apikey-result apikey-invalid">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <div>
          <p class="result-title">API Key inválida</p>
          <p class="result-sub">Verifica a chave e tenta novamente.</p>
        </div>
      </div>
    <% } %>

    <!-- DIVISOR HORIZONTAL -->
    <div class="divider-horizontal">
      <span>Login Social</span>
    </div>

    <!-- BLOCO 3: SOCIAL AUTH -->
    <div class="social-grid">

      <a href="/auth/github" class="btn btn-github">
        <svg class="social-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        <span>Login com GitHub</span>
      </a>

      <a href="/auth/google" class="btn btn-google">
        <svg class="social-icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        <span>Login com Google</span>
      </a>

      <a href="/auth/discord" class="btn btn-discord">
        <svg class="social-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028 14.09 14.09 0 001.226-1.994.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
        </svg>
        <span>Login com Discord</span>
      </a>

    </div><!-- /social-grid -->

    <% } %>

    <!-- ============================================================ -->
    <!-- ESTADO AUTENTICADO                                            -->
    <!-- ============================================================ -->
    <% if (user) { %>

    <div class="authenticated-state">

      <div class="auth-success-ring">
        <span class="check-symbol">&#10003;</span>
      </div>

      <p class="auth-greeting">Bem-vindo de volta,</p>
      <h2 class="auth-username"><%= user.firstName || 'Utilizador' %></h2>

      <% if (user.email) { %>
        <p class="auth-email"><%= user.email %></p>
      <% } %>

      <div class="auth-meta">
        <span class="meta-tag">&#9679; Sessão ativa</span>
      </div>

      <% if (apiKey && authMethod !== 'apikey') { %>
        <div class="apikey-display">
          <p class="apikey-label">A tua API Key:</p>
          <code class="apikey-value"><%= apiKey %></code>
          <p class="apikey-hint">Copia esta chave. Usa-a sem fazer login.</p>
        </div>
      <% } %>

      <a href="/auth/logout" class="btn btn-logout">
        <span class="btn-arrow"></span>
        <span>Terminar Sessão</span>
      </a>

    </div>

    <% } %>

  </main>

  <footer class="site-footer">
    <span>API Auth Portal &mdash; Node.js + Passport.js</span>
  </footer>

</body>
</html>
